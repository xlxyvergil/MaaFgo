            "default": "",
            "scan_dir": "resource/base/image/lizhuang",
            "scan_filter": "*.png",
            "cases": [],
            "pipeline_override": {
                "助战action": {
                    "attach": {
                        "冠位助战-2号礼装": "{冠位助战-2号礼装}"
