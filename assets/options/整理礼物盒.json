            ]
        },
        "整理礼物盒-QP满处理": {
            "type": "select",
            "label": "贩卖时 QP 满自动处理",
            "default": "on",
            "cases": [
                {
                    "name": "on",
                    "label": "自动点掉继续"
                },
                {
                    "name": "off",
                    "label": "停止贩卖",
                    "pipeline_override": {
                        "执行整理礼物盒": {
                            "attach": {
                                "aqf": false
                            }
                        },
                        "整理礼物盒-贩处理QP满": {
                            "action": {
                                "type": "DoNothing"
                            },
                            "next": [
                                "整理礼物盒-贩卖确认完成"
                            ]
                        }
                    }
                }
            ]
