        "整理礼物盒-保留三星数量": {
            "type": "input",
            "label": "保留三星数量",
            "inputs": [
                {
                    "name": "keep3_num",
                    "label": "保留数量（2-50）",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^([2-9]|[1-4][0-9]|50)$"
                }
            ],
            "pipeline_override": {
                "执行整理礼物盒": {
                    "attach": {
                        "keep3_num": "{keep3_num}"
                    }
                }
            }
        },
