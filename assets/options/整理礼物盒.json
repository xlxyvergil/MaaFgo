                    "name": "off",
                    "label": "不卖"
                },
                {
                    "name": "on",
                    "label": "贩卖",
                    "pipeline_override": {
                        "执行整理礼物盒": {
                            "attach": {
                                "sell4": true
                            }
                        },
                        "整理礼物盒-筛卖选4星": {
