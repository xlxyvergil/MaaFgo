{
    "option": {
        "整理礼物盒-整理大类": {
            "type": "select",
            "label": "整理礼物盒",
            "default": "on",
            "cases": [
                {
                    "name": "off",
                    "label": "不整理",
                    "pipeline_override": {
                        "执行整理礼物盒": {
                            "attach": {
                                "one_key3": false,
                                "one_key4": false,
                                "one_key5": false,
                                "keep3": false,
                                "keep4": false,
                                "keep5": false
                            }
                        }
                    }
                },
                {
                    "name": "on",
                    "label": "整理",
                    "option": [
                        "整理礼物盒-一键领取三星",
                        "整理礼物盒-一键领取四星",
                        "整理礼物盒-一键领取五星",
                        "整理礼物盒-保留三星",
                        "整理礼物盒-保留四星",
                        "整理礼物盒-保留五星"
                    ]
                }
            ]
        },
        "整理礼物盒-贩卖大类": {
            "type": "select",
            "label": "贩卖狗粮",
            "default": "off",
            "cases": [
                {
                    "name": "off",
                    "label": "不贩卖",
                    "pipeline_override": {
                        "执行整理礼物盒": {
                            "attach": {
                                "sell3": false,
                                "sell4": false,
                                "sell5": false
                            }
                        }
                    }
                },
                {
                    "name": "on",
                    "label": "贩卖",
                    "option": [
                        "整理礼物盒-贩卖三星",
                        "整理礼物盒-贩卖四星",
                        "整理礼物盒-贩卖五星",
                        "整理礼物盒-QP满处理"
                    ]
                }
            ]
        },
        "整理礼物盒-一键领取三星": {
            "type": "select",
