        "整理礼物盒-贩卖三星": {
            "type": "select",
            "label": "贩卖三星狗粮",
            "default": "off",
            "cases": [
                {
                    "name": "off",
                    "label": "不卖"
                },
                {
                    "name": "on",
                    "label": "贩卖",
                    "pipeline_override": {
                        "执行整理礼物盒": {
                            "attach": {
                                "sell3": true
                            }
                        },
                        "整理礼物盒-筛卖选3星": {
                            "next": [
                                "整理礼物盒-筛卖点3星"
                            ]
                        }
                    }
                }
            ]
        },
        "整理礼物盒-贩卖四星": {
            "type": "select",
            "label": "贩卖四星狗粮",
            "default": "off",
