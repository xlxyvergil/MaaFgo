{
    "option": {
        "原生自动战斗使用Chaldea队伍": {
            "type": "switch",
            "label": "使用编辑器/chaldea配置",
            "description": "使用编辑器或 Chaldea 方案中的编队与逐回合战斗配置。 [使用指南](https://www.bilibili.com/video/BV1Lueb6bEbW/)\n\n[启动编队与战斗编辑器](./打开编队编辑器.cmd) · [打开已启动的编辑器](http://127.0.0.1:18765/)",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "Chaldea助战action": {
                            "attach": {
                                "chaldea_enabled": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "Chaldea导入手动输入",
                        "Chaldea编队方式"
                    ],
                    "pipeline_override": {
                        "Chaldea助战action": {
                            "attach": {
                                "chaldea_enabled": true
                            }
                        }
                    }
                }
            ]
        },
        "Chaldea导入手动输入": {
            "type": "input",
            "label": "编辑器/chaldea方案导入",
            "description": "本地文件：config/Battle 下的队伍文件名。\n\n[启动编队与战斗编辑器](./打开编队编辑器.cmd) · [打开已启动的编辑器](http://127.0.0.1:18765/)",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍ID / 关卡ID / 本地文件",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file",
                    "file_dialog_dir": "config/Battle",
                    "file_dialog_filters": [
                        {"name": "JSON", "extensions": ["json"]},
                        {"name": "所有文件", "extensions": ["*"]}
                    ]
                }
            ],
            "pipeline_override": {
                "原生自动战斗入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}"
                            }
                        }
                    }
                },
                "原生自动战斗_多次入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle_repeat",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}"
                            }
                        }
                    }
                },
                "执行自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "执行手动编队检查": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "执行羁绊补齐自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "Chaldea助战action": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        },
        "Chaldea编队方式": {
            "type": "select",
            "label": "编队方式",
            "description": "手动核对从者并调整位置；自动按数据编队。有御主礼装数据时，手动只校验，不匹配则停止；自动完成更换。",
            "default": "手动",
            "cases": [
                {
                    "name": "手动",
                    "label": "手动",
                    "pipeline_override": {
                        "进本-编队处理": {
                            "next": [
                                "执行手动编队检查"
                            ]
                        },
                        "手动编队检查完成": {
                            "next": [
                                "进本-点击队伍确认"
                            ]
                        }
                    }
                },
                {
                    "name": "自动",
                    "label": "自动",
                    "option": [
                        "自动编队助战替代",
                        "自动编队礼装开关",
                        "自动补齐从者和羁绊礼装"
                    ],
                    "pipeline_override": {
                        "进本-编队处理": {
                            "next": [
                                "执行自动编队"
                            ]
                        },
                        "自动编队完成": {
                            "next": [
                                "进本-点击队伍确认"
                            ]
                        }
                    }
                }
            ]
        },
        "自动编队助战替代": {
            "type": "switch",
            "label": "是否用助战代替编队数据",
            "description": "chaldea数据里没有助战时，可用当前同名助战替代对应从者",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "use_support_substitution": false
                            }
                        },
                        "执行羁绊补齐自动编队": {
                            "attach": {
                                "use_support_substitution": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "use_support_substitution": true
                            }
                        },
                        "执行羁绊补齐自动编队": {
                            "attach": {
                                "use_support_substitution": true
                            }
                        }
                    }
                }
            ]
        },
        "自动编队礼装开关": {
            "type": "switch",
            "label": "自动编成礼装",
            "description": "",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是",
                    "option": [
                        "自动编队礼装缺失处理"
                    ],
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "auto_equip": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "auto_equip": false
                            }
                        }
                    }
                }
            ]
        },
        "自动编队礼装缺失处理": {
            "type": "select",
            "label": "满破礼装缺失时",
            "description": "",
            "default": "查找非满破礼装",
            "cases": [
                {
                    "name": "跳过礼装",
                    "label": "跳过该礼装",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "equip_missing_policy": "skip"
                            }
                        }
                    }
                },
                {
                    "name": "查找非满破礼装",
                    "label": "改查非满破版本",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "equip_missing_policy": "allow_non_limit_break"
                            }
                        }
                    }
                }
            ]
        }
    }
}
