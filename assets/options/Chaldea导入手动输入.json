{
    "option": {
        "Chaldea导入手动输入": {
            "type": "input",
            "label": "Chaldea 队伍导入（可选）",
            "description": "填写 Chaldea 的分享链接、队伍ID、关卡ID，或点击浏览按钮从本地选择队伍 JSON 文件。下载过的队伍缓存文件名（config/Battle 下，如\"诺100奥_77210_94149047\"）也可以直接填。留空则使用默认策略。",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍ID / 关卡ID / 本地文件（留空=默认策略）",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file"
                }
            ],
            "pipeline_override": {
                "原生自动战斗入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "原生自动战斗_多次入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle_repeat",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "执行自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        }
    }
}
