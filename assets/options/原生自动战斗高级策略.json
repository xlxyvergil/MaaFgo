{
  "option": {
    "原生自动战斗高级策略": {
      "type": "select",
      "label": "高级策略",
      "description": "调整自动补牌、等牌和补放技能；方案中已安排的操作优先。",
      "default": "default",
      "cases": [
        {
          "name": "default",
          "label": "默认",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_strategy_source": "default"
              }
            }
          }
        },
        {
          "name": "editor",
          "label": "使用编辑器/chaldea配置",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_strategy_source": "editor"
              }
            }
          }
        },
        {
          "name": "manual",
          "label": "手动",
          "option": [
            "原生自动战斗补牌预设",
            "原生自动战斗开局等待关键牌",
            "原生自动战斗策略微调",
            "原生自动战斗最大回合",
            "原生自动战斗自动补放技能"
          ],
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_strategy_source": "manual"
              }
            }
          }
        }
      ]
    },
    "原生自动战斗补牌预设": {
      "type": "select",
      "label": "原生补牌策略",
      "description": "仅补充方案未指定或未抽到的指令卡。",
      "default": "平衡",
      "cases": [
        {
          "name": "平衡",
          "label": "平衡：三色与勇猛链",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 8,
                    "mighty_chain_weight": 12,
                    "same_color_chain_weight": 5,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 3,
                      "A": 2,
                      "Q": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "三色",
          "label": "优先三色链",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 4,
                    "mighty_chain_weight": 32,
                    "same_color_chain_weight": 2,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 3,
                      "A": 2,
                      "Q": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "勇猛",
          "label": "优先同一从者勇猛链",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 32,
                    "mighty_chain_weight": 8,
                    "same_color_chain_weight": 4,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 3,
                      "A": 2,
                      "Q": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "回收",
          "label": "优先蓝卡与 NP 回收",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "build_np",
                  "color_priority": [
                    "A",
                    "Q",
                    "B"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 6,
                    "mighty_chain_weight": 10,
                    "same_color_chain_weight": 12,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 1,
                      "A": 4,
                      "Q": 2
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "旧策略",
          "label": "关闭增强补牌，沿用原策略",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "原生自动战斗开局等待关键牌": {
      "type": "switch",
      "label": "开局等待关键牌",
      "description": "等到目标从者的牌满足条件后，再执行首回合方案。仅适合从开局启动，战斗中途或选卡界面请关闭。",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "option": [
            "原生自动战斗开局等牌条件"
          ],
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_opening_hand_enabled": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_opening_hand_enabled": false
              }
            }
          }
        }
      ]
    },
    "原生自动战斗开局等牌条件": {
      "type": "input",
      "label": "开局等牌条件",
      "description": "设置目标从者ID或当前前排位置；ID优先。留空ID且位置为0时，可在补牌策略JSON的opening_hand中设置目标。牌色用B、A、Q表示红、蓝、绿，例如B,Q；允许重复。等待0回合表示只检查开局牌，不满足即停止。",
      "inputs": [
        {
          "name": "opening_hand_servant_id",
          "label": "目标从者ID（可留空）",
          "default": "",
          "verify": "^(?:[1-9][0-9]{0,11})?$"
        },
        {
          "name": "opening_hand_servant_slot",
          "label": "目标前排位置（0=未指定，1～3）",
          "default": "0",
          "pipeline_type": "int",
          "verify": "^[0-3]$"
        },
        {
          "name": "opening_hand_required_colors",
          "label": "所需面卡颜色",
          "default": "B,Q",
          "verify": "^[BAQ](?:,[BAQ]){0,2}$"
        },
        {
          "name": "opening_hand_max_wait_turns",
          "label": "最多普攻等待回合（0～5）",
          "default": "2",
          "pipeline_type": "int",
          "verify": "^[0-5]$"
        }
      ],
      "pipeline_override": {
        "原生自动战斗-高级策略配置": {
          "attach": {
            "native_battle_opening_hand_servant_id": "{opening_hand_servant_id}",
            "native_battle_opening_hand_servant_slot": "{opening_hand_servant_slot}",
            "native_battle_opening_hand_required_colors": "{opening_hand_required_colors}",
            "native_battle_opening_hand_max_wait_turns": "{opening_hand_max_wait_turns}"
          }
        }
      }
    },
    "原生自动战斗策略微调": {
      "type": "input",
      "label": "补牌策略微调（可选）",
      "description": "留空或 {} 沿用预设。可设置主输出从者ID、当前前排位置（1～3）、链权重、宝具颜色等，例如 {\"preferred_slots\":[2],\"brave_chain_weight\":20}。ID偏好会在换人后跟随该从者，例如 {\"preferred_servant_ids\":[\"605300\"]}。宝具颜色须明确提供，例如 {\"np_colors_by_servant_id\":{\"605300\":\"A\"}}。可用 {\"avoid_np_color_before_np\":true,\"np_color_preservation_weight\":40} 保护宝具前同角色同色次数增益。仅影响自动空位，明确出卡始终保持原顺序。",
      "inputs": [
        {
          "name": "native_strategy_overrides",
          "label": "补牌策略 JSON",
          "default": "{}",
          "verify": ".*"
        }
      ],
      "pipeline_override": {
        "原生自动战斗-高级策略配置": {
          "attach": {
            "native_strategy_overrides": "{native_strategy_overrides}"
          }
        }
      }
    },
    "原生自动战斗最大回合": {
      "type": "input",
      "label": "最大战斗回合",
      "description": "达到上限后停止，范围 1～100。",
      "inputs": [
        {
          "name": "max_turns",
          "label": "回合上限",
          "default": "40",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|[1-9][0-9]|100)$"
        }
      ],
      "pipeline_override": {
        "原生自动战斗-高级策略配置": {
          "attach": {
            "native_battle_max_turns": "{max_turns}"
          }
        }
      }
    },
    "原生自动战斗自动补放技能": {
      "type": "switch",
      "label": "自动补放从者技能",
      "description": "没有回合方案或方案已执行完时，自动使用可用的从者技能。需指定目标的技能请在编辑器中编排。",
      "default_case": "Yes",
      "cases": [
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_auto_servant_skills": false
              }
            }
          }
        },
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_auto_servant_skills": true
              }
            }
          }
        }
      ]
    }
  }
}
