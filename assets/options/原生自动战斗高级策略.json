{
  "option": {
    "原生自动战斗高级策略": {
      "type": "select",
      "label": "高级策略",
      "description": "调整自动补牌、等牌和补放技能；方案中已安排的操作优先。",
      "default": "default",
      "cases": [
        {
          "name": "default",
          "label": "默认",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_strategy_source": "default"
              }
            }
          }
        },
        {
          "name": "editor",
          "label": "使用编辑器/chaldea配置",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_strategy_source": "editor"
              }
            }
          }
        },
        {
          "name": "manual",
          "label": "手动",
          "option": [
            "原生自动战斗补牌优先级",
            "原生自动战斗补牌预设",
            "原生自动战斗主输出偏好",
            "原生自动战斗开局等待关键牌",
            "原生自动战斗策略微调",
            "原生自动战斗最大回合",
            "原生自动战斗自动补放技能"
          ],
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_strategy_source": "manual"
              }
            }
          }
        }
      ]
    },
    "原生自动战斗补牌优先级": {
      "type": "select",
      "label": "补牌优先级",
      "description": "优先从者：先尽量补主输出的普通卡，再比较连携策略；未指定主输出时，自动选择当前前排最靠前的攻击宝具从者。优先连携：先比较连携策略，再在同等组合中匹配主输出。方案中明确安排的出卡始终优先。",
      "default": "chain",
      "cases": [
        {
          "name": "servant",
          "label": "优先从者",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_fill_priority": "servant"
              }
            }
          }
        },
        {
          "name": "chain",
          "label": "优先连携",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_fill_priority": "chain"
              }
            }
          }
        }
      ]
    },
    "原生自动战斗补牌预设": {
      "type": "select",
      "label": "连携策略",
      "description": "仅补充方案未指定或未抽到的普通卡。与“补牌优先级”配合决定先匹配主输出还是先比较连携；原有预设和微调权重继续适用。",
      "default": "平衡",
      "cases": [
        {
          "name": "平衡",
          "label": "平衡：三色与勇猛链",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 8,
                    "mighty_chain_weight": 12,
                    "same_color_chain_weight": 5,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 3,
                      "A": 2,
                      "Q": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "三色",
          "label": "优先三色链",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 4,
                    "mighty_chain_weight": 32,
                    "same_color_chain_weight": 2,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 3,
                      "A": 2,
                      "Q": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "勇猛",
          "label": "优先同一从者勇猛链",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 32,
                    "mighty_chain_weight": 8,
                    "same_color_chain_weight": 4,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 3,
                      "A": 2,
                      "Q": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "回收",
          "label": "优先蓝卡与 NP 回收",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "build_np",
                  "color_priority": [
                    "A",
                    "Q",
                    "B"
                  ],
                  "native_strategy": {
                    "enabled": true,
                    "prefer_brave_chain": true,
                    "brave_chain_weight": 6,
                    "mighty_chain_weight": 10,
                    "same_color_chain_weight": 12,
                    "servant_priority_weight": 4,
                    "color_weights": {
                      "B": 1,
                      "A": 4,
                      "Q": 2
                    }
                  }
                }
              }
            }
          }
        },
        {
          "name": "旧策略",
          "label": "关闭增强补牌，沿用原策略",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_card_policy": {
                  "goal": "finish_wave",
                  "color_priority": [
                    "B",
                    "A",
                    "Q"
                  ],
                  "native_strategy": {
                    "enabled": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "原生自动战斗主输出偏好": {
      "type": "select",
      "label": "主输出偏好",
      "description": "按「补牌优先级」决定何时优先补主输出的普通卡。自动补放技能需要选队友时，也优先选主输出。按前排位置时，以所选位置上的从者为准。按从者时，换人后继续跟随该从者。选择「沿用补牌策略」时保留微调中的目标。补牌选择「优先从者」且未设置主输出时，自动选择前排最靠左的攻击宝具从者。",
      "default": "inherit",
      "cases": [
        {
          "name": "inherit",
          "label": "沿用补牌策略",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_preferred_attacker": ""
              }
            }
          }
        },
        {
          "name": "slot",
          "label": "按前排位置",
          "option": ["原生自动战斗主输出位置"]
        },
        {
          "name": "servant",
          "label": "按从者",
          "option": ["原生自动战斗主输出职阶"]
        }
      ]
    },
    "原生自动战斗主输出位置": {
      "type": "select",
      "label": "主输出位置",
      "default": "1",
      "cases": [
        {
          "name": "1",
          "label": "前排 1 号位（左）",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_preferred_attacker": 1
              }
            }
          }
        },
        {
          "name": "2",
          "label": "前排 2 号位（中）",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_preferred_attacker": 2
              }
            }
          }
        },
        {
          "name": "3",
          "label": "前排 3 号位（右）",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_preferred_attacker": 3
              }
            }
          }
        }
      ]
    },
    "原生自动战斗开局等待关键牌": {
      "type": "switch",
      "label": "开局等待关键牌",
      "description": "等到目标从者的牌满足条件后，再执行首回合方案。仅适合从开局启动，战斗中途或选卡界面请关闭。",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "开启",
          "option": [
            "原生自动战斗开局等牌目标职阶",
            "原生自动战斗开局等牌条件"
          ],
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_opening_hand_enabled": true
              }
            }
          }
        },
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_opening_hand_enabled": false
              }
            }
          }
        }
      ]
    },
    "原生自动战斗开局等牌条件": {
      "type": "input",
      "label": "开局等牌条件",
      "description": "在“目标从者职阶”和“目标从者”中按头像选人。未指定从者时，使用当前前排位置或补牌策略 JSON 的 opening_hand 目标；微调中的目标从者 ID 优先于前排位置，位置 0 表示未指定。牌色用 B、A、Q 表示红、蓝、绿，例如 B,Q，可重复。等待 0 回合表示只检查开局牌，不满足即停止。",
      "inputs": [
        {
          "name": "opening_hand_servant_slot",
          "label": "目标前排位置（0=未指定，1～3）",
          "default": "0",
          "pipeline_type": "int",
          "verify": "^[0-3]$"
        },
        {
          "name": "opening_hand_required_colors",
          "label": "所需面卡颜色",
          "default": "B,Q",
          "verify": "^[BAQ](?:,[BAQ]){0,2}$"
        },
        {
          "name": "opening_hand_max_wait_turns",
          "label": "最多普攻等待回合（0～5）",
          "default": "2",
          "pipeline_type": "int",
          "verify": "^[0-5]$"
        }
      ],
      "pipeline_override": {
        "原生自动战斗-高级策略配置": {
          "attach": {
            "native_battle_opening_hand_servant_slot": "{opening_hand_servant_slot}",
            "native_battle_opening_hand_required_colors": "{opening_hand_required_colors}",
            "native_battle_opening_hand_max_wait_turns": "{opening_hand_max_wait_turns}"
          }
        }
      }
    },
    "原生自动战斗策略微调": {
      "type": "input",
      "label": "补牌策略微调（可选）",
      "description": "留空或 {} 沿用预设。「主输出偏好」选择位置或从者时，以该选项为准。选择「沿用补牌策略」时，可在这里填写原有的主输出偏好。也可以设置链权重、宝具颜色，例如 {\"brave_chain_weight\":20,\"np_colors_by_servant_id\":{\"605300\":\"A\"}}。可用 {\"avoid_np_color_before_np\":true,\"np_color_preservation_weight\":40} 保护宝具前同角色同色次数增益。补牌权重和宝具颜色用于自动补牌，明确出卡保持原顺序。",
      "inputs": [
        {
          "name": "native_strategy_overrides",
          "label": "补牌策略 JSON",
          "default": "{}",
          "verify": ".*"
        }
      ],
      "pipeline_override": {
        "原生自动战斗-高级策略配置": {
          "attach": {
            "native_strategy_overrides": "{native_strategy_overrides}"
          }
        }
      }
    },
    "原生自动战斗最大回合": {
      "type": "input",
      "label": "最大战斗回合",
      "description": "达到上限后停止，范围 1～100。",
      "inputs": [
        {
          "name": "max_turns",
          "label": "回合上限",
          "default": "40",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|[1-9][0-9]|100)$"
        }
      ],
      "pipeline_override": {
        "原生自动战斗-高级策略配置": {
          "attach": {
            "native_battle_max_turns": "{max_turns}"
          }
        }
      }
    },
    "原生自动战斗自动补放技能": {
      "type": "switch",
      "label": "自动补放从者技能",
      "description": "当前回合没有方案或已超出方案时，自动使用可用的从者技能。需要选队友时，优先选当前前排的主输出。未设置或在前排找不到主输出时，选最靠左且确认拥有攻击宝具的从者。都无法确认时，选最靠左的前排从者。编辑器回合方案中指定的技能目标按方案执行。",
      "default_case": "Yes",
      "cases": [
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_auto_servant_skills": false
              }
            }
          }
        },
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "原生自动战斗-高级策略配置": {
              "attach": {
                "native_battle_auto_servant_skills": true
              }
            }
          }
        }
      ]
    }
  }
}
