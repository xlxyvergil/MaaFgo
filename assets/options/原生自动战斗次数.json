{
    "option": {
        "原生自动战斗次数": {
            "type": "input",
            "label": "战斗次数",
            "inputs": [
                {
                    "name": "battle_count",
                    "label": "次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "原生自动战斗_多次入口": {
                    "attach": {
                        "battle_count": "{battle_count}"
                    }
                }
            }
        }
    }
}
