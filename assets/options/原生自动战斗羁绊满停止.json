{
  "option": {
    "原生自动战斗羁绊满停止": {
      "type": "select",
      "label": "羁绊满时停止",
      "description": "在战后羁绊结算页检查 MAX，命中后截图并停止后续战斗。所有从者表示任意自有从者满羁绊即停止；号位以本场出战编队1～6号位为准，助战和空位不参与结算。指定号位若被羁绊升级展示遮挡，且连续战斗或清Free任务仍有原定战斗次数，将留待下一场结算复核，不额外加场；没有余次则保留现场提示未确认。升级本身不等于满羁绊，所有从者模式遇遮挡未确认仍停止。编队映射缺失等其他异常会保留现场并提示。",
      "default": "off",
      "cases": [
        {
          "name": "off",
          "label": "关闭",
          "pipeline_override": {
            "原生自动战斗-羁绊停止配置": {
              "attach": {
                "native_bond_stop_mode": "off",
                "native_bond_stop_slot": 0
              }
            },
            "结算-羁绊满停止": {
              "enabled": false
            },
            "战斗_胜利": {
              "recognition": {
                "type": "TemplateMatch",
                "param": {
                  "template": "battle/下一步.png",
                  "roi": [
                    0,
                    0,
                    0,
                    0
                  ],
                  "threshold": 0.8
                }
              }
            }
          }
        },
        {
          "name": "all",
          "label": "所有从者",
          "pipeline_override": {
            "原生自动战斗-羁绊停止配置": {
              "attach": {
