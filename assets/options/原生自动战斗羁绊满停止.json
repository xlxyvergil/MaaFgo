{
  "option": {
    "原生自动战斗羁绊满停止": {
      "type": "select",
      "label": "羁绊满时停止",
      "description": "结算时发现羁绊 MAX 后截图停止。“所有从者”指任意自有从者；号位按出战编队计算，不含助战。指定号位被升级展示遮挡时，有剩余次数则在下一场复核，不额外加场。",
      "default": "off",
      "cases": [
        {
          "name": "off",
          "label": "关闭",
          "pipeline_override": {
            "原生自动战斗-羁绊停止配置": {
              "attach": {
                "native_bond_stop_mode": "off",
                "native_bond_stop_slot": 0
              }
            },
            "结算-羁绊满停止": {
              "enabled": false
            },
            "战斗_胜利": {
              "recognition": {
                "type": "TemplateMatch",
                "param": {
                  "template": "battle/下一步.png",
                  "roi": [
                    0,
                    0,
                    0,
                    0
                  ],
                  "threshold": 0.8
                }
              }
            }
          }
        },
        {
