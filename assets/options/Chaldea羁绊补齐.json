{
  "option": {
    "自动补齐从者和羁绊礼装": {
      "type": "select",
      "label": "自动补齐从者和羁绊礼装",
      "description": "原编队完成后，在 COST 上限内补齐从者和羁绊礼装。会扫描玩家仓库；助战及 Chaldea 已指定位置不改，未指定位置按子选项处理。",
      "default": "否",
      "cases": [
        {
          "name": "否",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"bond_completion_enabled": false}}
          }
        },
        {
          "name": "是",
          "label": "是",
          "option": ["补齐从者优先X星", "羁绊基础值", "使用本地从者库", "使用本地礼装库", "自动修改其他位置从者", "自动修改其他位置礼装"],
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"bond_completion_enabled": true}}
          }
        }
      ]
    },
    "补齐从者优先X星": {
      "type": "select",
      "label": "补齐从者优先星级",
      "description": "先完整扫描该星级；没有可用对象时，再按 5→0 星回退。",
      "default": "5星",
      "cases": [
        {"name": "5星", "label": "5星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 5}}}},
        {"name": "4星", "label": "4星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 4}}}},
        {"name": "3星", "label": "3星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 3}}}},
        {"name": "2星", "label": "2星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 2}}}},
        {"name": "1星", "label": "1星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 1}}}},
        {"name": "0星", "label": "0星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 0}}}}
      ]
    },
    "使用本地从者库": {
      "type": "select",
      "label": "使用本地从者库",
      "description": "读取构建任务生成的 player_servants.json，跳过各星级的持有收集扫描，直接规划并定位目标。文件无效时自动回退实时扫描；仓库变化后请重新构建。",
      "default": "否",
      "cases": [
        {
          "name": "否",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_servant_inventory": false}}
          }
        },
        {
          "name": "是",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_servant_inventory": true}}
          }
        }
      ]
    },
    "使用本地礼装库": {
      "type": "select",
      "label": "使用本地礼装库",
      "description": "读取构建任务生成的 player_equips.json，只在已知持有礼装中规划并跳过库存预检。满破状态仍在选择时确认；文件无效时自动回退实时扫描。",
      "default": "否",
      "cases": [
        {
          "name": "否",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_equip_inventory": false}}
          }
        },
        {
          "name": "是",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_equip_inventory": true}}
          }
        }
      ]
    },
    "自动修改其他位置从者": {
      "type": "select",
      "label": "自动修改其他位置从者",
      "description": "Chaldea 未指定的空目标位若残留旧从者，是否允许替换。选否时保留并识别该从者，以其特性继续计算；真正的空位仍可补齐。",
      "default": "是",
      "cases": [
        {
          "name": "是",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_servants": true}}
          }
        },
        {
          "name": "否",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_servants": false}}
          }
        }
      ]
    },
    "自动修改其他位置礼装": {
      "type": "select",
      "label": "自动修改其他位置礼装",
      "description": "Chaldea 未指定礼装但该位置已有礼装时，是否允许先卸下并重新优化。选否时保留原礼装；真正的空礼装位仍可补齐。",
      "default": "是",
      "cases": [
        {
          "name": "是",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_equips": true}}
          }
        },
        {
          "name": "否",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_equips": false}}
          }
        }
      ]
    },
    "羁绊基础值": {
      "type": "input",
      "label": "羁绊基础值",
      "description": "用于比较百分比礼装和固定值礼装，必须为正整数。",
      "inputs": [
        {
          "name": "bond_base",
          "label": "羁绊基础值",
          "default": "1200",
          "verify": "^[1-9][0-9]*$",
          "pipeline_type": "int"
        }
      ],
      "pipeline_override": {
        "执行羁绊补齐自动编队": {"attach": {"bond_base": "{bond_base}"}}
      }
    }
  }
}
