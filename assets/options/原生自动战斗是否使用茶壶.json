{
  "option": {
    "原生自动战斗是否使用茶壶": {
      "type": "switch",
      "label": "是否使用茶壶",
      "description": "进入战斗前将茶壶开关调整为所选状态；关闭时也会检测并关闭已开启的茶壶。无茶壶选项的副本提示后继续。",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "关闭",
          "pipeline_override": {
            "原生战斗-茶壶配置": {
              "attach": {"use_teapot": false}
            }
          }
        },
        {
          "name": "Yes",
          "label": "开启",
          "pipeline_override": {
            "原生战斗-茶壶配置": {
              "attach": {"use_teapot": true}
            }
          }
        }
      ]
    }
  }
}
