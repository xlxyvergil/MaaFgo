{
  "option": {
    "原生自动战斗是否使用茶壶": {
      "type": "select",
      "label": "是否使用茶壶",
      "description": "使用：确认并开启茶壶；不使用：确认并关闭茶壶；不检测：跳过茶壶检测和设置，沿用游戏内当前状态。",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "使用",
          "pipeline_override": {
            "原生战斗-茶壶配置": {
              "attach": {"use_teapot": true}
            }
          }
        },
        {
          "name": "No",
          "label": "不使用",
          "pipeline_override": {
            "原生战斗-茶壶配置": {
              "attach": {"use_teapot": false}
            }
          }
        },
        {
          "name": "Skip",
          "label": "不检测",
          "pipeline_override": {
            "原生战斗-茶壶配置": {
              "attach": {"use_teapot": "skip"}
            }
          }
        }
      ]
    }
  }
}
