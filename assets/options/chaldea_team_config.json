{
    "option": {
        "chaldea_team_config": {
            "type": "input",
            "label": "编辑器/chaldea方案导入",
            "description": "本地文件：config/Battle 下的队伍文件名。\n\n[启动编队与战斗编辑器](./打开编队编辑器.cmd) · [打开已启动的编辑器](http://127.0.0.1:18765/)",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍ID / 关卡ID / 本地文件",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file",
                    "file_dialog_dir": "config/Battle",
                    "file_dialog_filters": [
                        {"name": "JSON", "extensions": ["json"]},
                        {"name": "所有文件", "extensions": ["*"]}
                    ]
                }
            ],
            "pipeline_override": {
                "bbc战斗": {
                    "next": "使用chaldea队伍"
                },
                "使用chaldea队伍": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        }
    }
}
