{
    "option": {
        "原生自动战斗助战方式": {
            "type": "select",
            "label": "助战方式",
            "default": "首个助战",
            "cases": [
                {
                    "name": "自定义助战",
                    "label": "自定义助战",
                    "option": [
                        "助战类型",
