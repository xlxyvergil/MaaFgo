{
    "结算-羁绊满停止": {
        "doc": "默认关闭。开启时先确认羁绊结算页并按本节点配置有界等待动画，明确MAX或其他无法确认的异常仍保存证据停止。已确认升级展示且配置及指定号位映射可信时，有既定下一场则保存待复核证据，明确最后一场则正常完成结算并允许后续任务；未声明预算不能当作末场。所有模式不按升级等级推断MAX，不额外加场。此节点不用JumpBack；末场继续与下场复核均不锁存真正停止，参见结算-羁绊升级继续。",
        "enabled": false,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "native_bond_max"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "save_native_bond_stop"
            }
        },
        "attach": {
            "check_attempts": 3,
            "check_wait_node": "结算-羁绊停止等待动画",
            "page_wait_node": "结算-等待羁绊出现",
            "page_wait_attempts": 80,
            "page_wait_timeout_ms": 5000,
            "positive_wait_node": "结算-羁绊快速复核",
            "positive_attempts": 20,
            "positive_timeout_ms": 2000
        },
        "next": ["结算-羁绊停止出口"],
        "on_error": ["结算-羁绊停止异常出口"]
    },
    "结算-羁绊升级继续": {
        "doc": "正常顺序为羁绊→可选升级展示→经验→战利品。先由结算-羁绊满停止处理MAX及升级继续状态，再双重确认升级展示及本场许可后跳过。守卫开启时允许已登记下场复核或已确认末场正常结算的升级展示；仅设置末场预算不足以授权，未登记、预算未知或MAX已锁存均不点击。固定手势参考剧情奖励-展示继续；max_hit由每场repeat重置，JumpBack返回原结算调度，不开始额外场次。",
        "recognition": {"type": "And", "param": {"all_of": [
            "羁绊结算-升级展示",
            {"recognition": {"type": "Custom", "param": {"custom_recognition": "native_bond_upgrade_continue"}}}
        ]}},
        "action": {"type": "Click", "param": {"target": [1203, 72, 1, 1]}},
        "post_delay": 500, "max_hit": 12, "timeout": 3000,
        "next": [], "on_error": []
    },
    "结算-等待羁绊出现": {
        "doc": "正常顺序为羁绊→经验→战利品。战后RESULT或羁绊页特征成立后，只等待羁绊页或明确羁绊升级展示，不点击；若已经到经验或战利品页则记录本场漏检并停止。总次数与截止时间读取结算-羁绊满停止.attach。前置出卡等待开启守卫时禁止右上角盲点，参见战斗_经验结算页。",
        "pre_delay": 50,
        "post_delay": 0,
        "action": {"type": "DoNothing"},
        "next": [],
        "on_error": []
    },
    "结算-羁绊快速复核": {
        "doc": "羁绊页初帧尚未MAX时先短间隔观察；阳性立即锁存。明确升级展示遮挡时，仍有既定次数时可保存证据延后到下一场；其他未知遮挡仍停止。无MAX结论须严格冻结确认。",
        "pre_delay": 100,
        "post_delay": 0,
        "action": {"type": "DoNothing"},
        "next": [],
        "on_error": []
    },
    "结算-羁绊停止等待动画": {
        "doc": "羁绊页检查间隔与冻结参数由Pipeline维护。自定义识别先等待600ms，再读取本节点post_wait_freezes调用Context.wait_freezes并严格检查布尔结果；节点本身的冻结超时不会使run_task失败，不能只依赖其任务状态。冻结确认后取新帧，有限轮次内至少两帧一致才允许未满放行。",
        "pre_delay": 600,
        "action": {"type": "DoNothing"},
        "post_wait_freezes": {
            "time": 1000,
            "target": [80, 450, 1120, 100],
            "threshold": 0.95,
            "method": 5,
            "rate_limit": 200,
            "timeout": 8000
        },
        "next": [],
        "on_error": []
    },
    "结算-羁绊停止出口": {
        "doc": "终止当前Pipeline，保留羁绊结算现场。StopTask可能报告succeeded，repeat、主线和Free必须同时检查根任务业务停止状态，不能据此开始下一场。截图保存失败也到此停止。",
        "action": {"type": "StopTask"},
        "next": [],
        "on_error": []
    },
    "结算-羁绊停止异常出口": {
        "doc": "羁绊守卫动作异常时同样终止Pipeline，外层仍消费根任务停止原因。独立节点避免next与on_error指向同名出口，触发maa-checker重复路由错误；不得在异常路径继续结算或开始下一场。",
        "action": {"type": "StopTask"},
        "next": [],
        "on_error": []
    },
