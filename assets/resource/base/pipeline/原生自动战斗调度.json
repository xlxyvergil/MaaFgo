        "post_delay": 1000,
        "next": [
            "进本-开始后弹窗检查",
            "进本-开始按钮已消失"
        ]
    },
    "进本-开始后弹窗检查": {
        "doc": "点击开始任务后, 告知弹窗可能慢几帧才出现并吞掉点击。出现弹窗则关闭并回队伍确认重点; 开始按钮消失则视为已进本, 结束进本链(JumpBack正常生效)。注意: 不能用on_error做成功出口, on_error属于错误处理路径, 会导致JumpBack失效、整条任务链失败",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "close_botton.png",
                    "close.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "next": [
            "进本-开始后弹窗检查",
            "进本-开始按钮已消失"
        ],
        "timeout": 10000
    },
    "进本-等待战斗主界面或剧情": {
        "doc": "开始按钮消失后, 剧情的跳过按钮可能还需几秒才出现, 不能立即以'按钮消失'作为进本完成。等待战斗主界面(真正进战斗)或剧情跳过按钮出现, 剧情跳完后回本节点继续等主界面",
        "next": [
            "进本-战斗主界面已出现",
            "[JumpBack]跳过剧情-点击跳过"
        ],
        "timeout": 60000
    },
    "进本-战斗主界面已出现": {
        "doc": "战斗主界面出现, 进本完成。空next正常结束, JumpBack回父节点继续后续流程",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true
            }
        }
    },
    "进本-开始按钮已消失": {
        "doc": "开始任务/战斗开始按钮不再出现, 视为已成功进入战斗加载。进入 进本-等待战斗主界面或剧情, 由其确认战斗主界面出现后才结束进本链",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "battle/开始任务.png",
                    "battle/战斗开始.png"
                ],
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "next": [
            "进本-等待战斗主界面或剧情"
        ]
    },
    "进本-点击关卡-等待界面切换": {
        "doc": "点击关卡后等待离开关卡选择界面(task.png消失), 给AP弹窗/任务弹窗出现留足轮询时间, 防止空节点过早兜底",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "task.png",
                "green_mask": true
            }
        },
        "inverse": true,
        "timeout": 10000,
        "on_error": [
            "进本-点击关卡-重试"
        ]
    },
    "进本-点击关卡-重试": {
