{
    "跳过剧情-点击跳过": {
        "doc": "通用剧情跳过(跨文件复用: 原生自动战斗调度/进本流程/战斗完成 均引用)。OCR识别右上角'跳过'按钮并点击。跳过按钮为竖排半透明样式, OCR 常将'跳过'误识为'物'(2026-09-05 日志实证: box命中 score 0.998 但 text='物'), 故 expected 同时接受两者",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1143,
                    24,
                    80,
                    35
                ],
                "expected": [
                    "跳过",
                    "物"
                ],
                "threshold": 0.5
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 100,
        "timeout": 5000,
        "next": [
            "跳过剧情-确认跳过",
            "跳过剧情-确认跳过-已消失"
        ]
    },
    "跳过剧情-直接点击跳过": {
        "doc": "盲点方案: 直接点击右上角跳过按钮位置(半透明按钮 OCR/模板均不稳), 再用'是'确认弹窗反向验证。适用于一次性过渡点(如编队提示点击开始后): 有剧情→弹窗出现→点击是; 无剧情→盲点一次无害→无确认弹窗节点命中→链结束回跳。不适用于持续轮询场景(反复盲点有误触风险)",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1143,
                    24,
                    80,
                    35
                ]
            }
        },
        "post_delay": 500,
        "timeout": 5000,
        "next": [
            "跳过剧情-确认跳过",
            "跳过剧情-无确认弹窗"
        ]
    },
    "跳过剧情-无确认弹窗": {
        "doc": "盲点后'是'弹窗未出现 = 当前不是剧情(或无需确认), 视为跳过完成, 链结束回跳父节点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    756,
                    535,
                    144,
                    49
                ],
                "template": "battle/是.png",
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "on_error": [
            "跳过剧情-点击跳过"
        ]
    },
    "跳过剧情-确认跳过": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    756,
                    535,
                    144,
                    49
                ],
                "template": "battle/是.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "跳过剧情-确认跳过-已消失": {
        "doc": "点击跳过后'是'弹窗未出现(部分剧情无需确认/弹窗被吞), 视为跳过完成, 链结束回跳父节点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    756,
                    535,
                    144,
                    49
                ],
                "template": "battle/是.png",
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "on_error": [
            "跳过剧情-点击跳过"
        ]
    }
}
