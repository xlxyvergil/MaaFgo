{
    "完成跳过剧情": {},
    "战斗-出卡后剧情处理": {
        "doc": "出卡后的剧情中断入口，仅在运行时已识别到 跳过剧情-点击跳过 时调用。优先处理已打开的确认框，再复用战后跳过节点。调用方仅在本次子任务覆盖出口到 战斗-剧情切换等待，避免跳过-可能在主界面误点地图；返回后必须重新判断战斗或结算，不能直接认定胜利。2026-10-14 日服 MaaMCP 已验证确认跳过；剧情可能直接回列表，运行时须停止盲点，并组合 可能已经结束战斗_不回主界面 与 战斗结束-主界面 稳定确认后交回调度。",
        "timeout": 5000,
        "next": [
            "跳过剧情-确认跳过",
            "跳过剧情-点击跳过"
        ]
    },
    "战斗-剧情切换等待": {
        "doc": "复用剧情跳过按钮后等待切换动画，避免旧帧再次触发 SKIP。只等待，不点击、不进入结算。",
        "post_delay": 4000
    },
    "跳过-可能在主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "主界面圣晶石.png",
                    "task.png",
                    "菜单.png",
                    "菜单.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "完成跳过剧情"
        ]
    },
    "跳过剧情-无确认弹窗": {
        "doc": "盲点后'是'弹窗未出现 = 当前不是剧情(或无需确认), 视为跳过完成, 链结束回跳父节点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    756,
                    535,
                    144,
                    49
                ],
                "template": "battle/是.png",
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "on_error": [
            "跳过剧情-点击跳过"
        ]
    },
    "跳过剧情-点击跳过": {
        "doc": "通用剧情跳过(跨文件复用: 原生自动战斗调度/进本流程/战斗完成 均引用)。OCR识别右上角'跳过'按钮并点击。跳过按钮为竖排半透明样式, OCR 常将'跳过'误识为'物'(2026-09-05 日志实证: box命中 score 0.998 但 text='物'), 故 expected 同时接受两者",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1143,
                    24,
                    80,
                    35
                ],
                "expected": [
                    "跳过",
                    "物",
                    "SKIP"
                ],
                "threshold": 0.5
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 100,
        "timeout": 5000,
        "next": [
            "跳过剧情-确认跳过",
            "跳过剧情-确认跳过-已消失",
            "跳过-可能在主界面"
        ]
    },
    "跳过剧情-直接点击跳过": {
        "doc": "直接点击剧情跳过位置，再确认或等待无确认框。只处理剧情确认，不点击主界面或列表菜单；持续轮询由进本专用60次包装节点限制。",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1143,
                    24,
                    80,
                    35
                ]
            }
        },
        "post_delay": 500,
        "timeout": 5000,
        "next": [
            "跳过剧情-确认跳过",
            "跳过剧情-无确认弹窗"
        ],
        "on_error": []
    },
    "跳过剧情-确认跳过": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    756,
                    535,
                    144,
                    49
                ],
                "template": "battle/是.png",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "完成跳过剧情"
        ]
    },
    "跳过剧情-确认跳过-已消失": {
        "doc": "点击跳过后'是'弹窗未出现(部分剧情无需确认/弹窗被吞), 视为跳过完成, 链结束回跳父节点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    756,
                    535,
                    144,
                    49
                ],
                "template": "battle/是.png",
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "on_error": [
            "跳过剧情-点击跳过"
        ]
    }
