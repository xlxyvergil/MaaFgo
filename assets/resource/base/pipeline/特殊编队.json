        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["进本-编队限制已开启", "进本-限制编队确认开始"],
                "box_index": 1
            }
        },
        "action": {"type": "Custom", "param": {"custom_action": "mark_native_formation_restricted"}},
        "next": [
            "进本-点击队伍确认"
        ],
        "on_error": [],
        "doc": "确认队伍可以开战且没有必填空槽后，记录限制并重新采集实际编队。点击后的条件拒绝由通用恢复分支处理。"
    }
