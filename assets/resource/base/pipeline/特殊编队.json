    "特殊编队-白字过滤": {
        "enabled": false,
        "doc": "限制提示正文的白字过滤，按 MaaFramework OCR.color_filter 单独识别，避免助战背景文字批量识别片段异常。",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 4,
                "lower": [
                    170,
                    170,
                    170
                ],
                "upper": [
                    255,
                    255,
                    255
                ]
            }
        }
    },
