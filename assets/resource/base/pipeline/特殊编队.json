                "box_index": 1
            }
        },
        "enabled": true,
        "doc": "开启编队限制处理后，识别编成条件拒绝、限制告知、编队来源、游戏自动编成确认或受限队伍决定页。",
        "next": [
            "特殊编队-编成条件未满足",
            "特殊编队-限制提示关闭",
            "特殊编队-取消编队来源",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定"
        ],
        "timeout": 30000,
        "on_error": [],
        "post_delay": 0
    },
    "特殊编队-编成条件未满足": {
        "enabled": true,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "进本-编队限制已开启",
                    {
                        "sub_name": "base/特殊编队/特殊编队-编成条件未满足/OCR2",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    450,
                                    550,
                                    380,
                                    100
                                ],
                                "expected": [
                                    "^(?:关闭|閉じる)$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "sub_name": "base/特殊编队/特殊编队-编成条件未满足/OCR1",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    360,
                                    55,
                                    620,
                                    110
                                ],
                                "expected": [
                                    "无法满足编成条件|編成条件を満たしていません|編成条件を満たしていない"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "doc": "开启编队限制处理且游戏明确拒绝编成条件时，点击关闭并调用游戏自动编队。",
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "特殊编队-取消编队来源",
            "特殊编队-打开自动编队",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定"
        ],
        "timeout": 30000,
        "on_error": [],
        "max_hit": 6
    },
