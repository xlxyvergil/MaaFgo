{
    "进本-特殊编队处理": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "特殊编队-编成条件未满足",
                    "特殊编队-限制提示关闭",
                    "特殊编队-自动编成确认",
                    "特殊编队-队伍决定"
                ]
            }
        },
        "enabled": true,
        "doc": "通用特殊编队入口：识别编成条件拒绝、限制告知、游戏自动编成确认或受限队伍决定页；不匹配活动章节、从者姓名、肖像或站位。",
        "next": [
            "特殊编队-编成条件未满足",
            "特殊编队-限制提示关闭",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定"
        ],
        "timeout": 30000,
        "on_error": [],
        "post_delay": 0
    },
    "特殊编队-编成条件未满足": {
        "enabled": true,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    360,
                                    55,
                                    620,
                                    110
                                ],
                                "expected": [
                                    "无法满足编成条件"
                                ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    450,
                                    550,
                                    380,
                                    100
                                ],
                                "expected": [
                                    "^关闭$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "doc": "仅在游戏明确拒绝编成条件且显示关闭按钮时恢复，关闭错误后调用游戏自动编队满足本关限制。",
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "特殊编队-打开自动编队",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定"
        ],
        "timeout": 30000,
        "on_error": [],
        "max_hit": 6
    },
    "特殊编队-打开自动编队": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "进本-队伍确认",
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    260,
                                    640,
                                    85,
                                    75
                                ],
                                "expected": [
                                    "^自动$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "doc": "编成被游戏拒绝后，正向确认普通队伍页和自动编队按钮，再打开游戏自动编成；不在正常进本时重新编队。",
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "特殊编队-自动编成确认"
        ],
        "timeout": 30000,
        "on_error": [],
        "max_hit": 6
    },
    "特殊编队-限制提示关闭": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    170,
                                    145,
                                    940,
                                    385
                                ],
                                "expected": [
                                    "首发|不可.*(?:编|出击)|禁止.*(?:编|出击)|编[队制成].*限制|固定.*(?:位置|外观|灵基|编队|编成|成员|从者)|(?:外观|灵基|成员|从者).*固定|战斗形象|再临|从者.*任选|任选.*从者"
                                ],
                                "threshold": 0.8,
                                "color_filter": "特殊编队-白字过滤"
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    450,
                                    550,
                                    380,
                                    100
                                ],
                                "expected": [
                                    "^关闭$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "doc": "以限制提示用语及关闭按钮识别弹窗，连续出现的首发、禁止成员、外观及任选成员提示复用同一节点。",
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "特殊编队-限制提示关闭",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定",
            "特殊编队-开始任务"
        ],
        "timeout": 30000,
        "on_error": [],
        "max_hit": 12
    },
    "特殊编队-自动编成确认": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    360,
                                    40,
                                    620,
                                    145
                                ],
                                "expected": [
                                    "^自动编成(?:执行确认)?$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    740,
                                    510,
                                    350,
                                    140
                                ],
                                "expected": [
                                    "^自动编成$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "doc": "由游戏自动编成满足本关限制的队伍，不维护指定角色组合。",
        "action": {
            "type": "Click"
        },
        "post_delay": 1500,
        "next": [
            "特殊编队-限制提示关闭",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定",
            "特殊编队-开始任务"
        ],
        "timeout": 30000,
        "on_error": [],
        "max_hit": 6
    },
    "特殊编队-队伍决定": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "Or",
                            "param": {
                                "any_of": [
                                    {
                                        "recognition": {
                                            "type": "OCR",
                                            "param": {
                                                "roi": [
                                                    400,
                                                    15,
                                                    520,
                                                    100
                                                ],
                                                "expected": [
                                                    "首发队员|编成限制|受限"
                                                ],
                                                "threshold": 0.75
                                            }
                                        }
                                    },
                                    {
                                        "recognition": {
                                            "type": "OCR",
                                            "param": {
                                                "roi": [
                                                    25,
                                                    315,
                                                    1255,
                                                    105
                                                ],
                                                "expected": [
                                                    "出击成员固|编队限制|限定.*出击"
                                                ],
                                                "threshold": 0.75
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    1040,
                                    625,
                                    240,
                                    90
                                ],
                                "expected": [
                                    "^决定$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "doc": "受限队伍页由游戏校验编队条件，识别限制标识与决定按钮后确认；后续汇合于原生采集与开始边界，不套用普通 Chaldea 重新编队。",
        "action": {
            "type": "Click"
        },
        "post_delay": 1500,
        "next": [
            "特殊编队-决定后判分"
        ],
        "on_error": [],
        "max_hit": 6
    },
    "特殊编队-白字过滤": {
        "enabled": false,
        "doc": "限制提示正文的白字过滤，按 MaaFramework OCR.color_filter 单独识别，避免助战背景文字批量识别片段异常。",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "method": 4,
                "lower": [
                    170,
                    170,
                    170
                ],
                "upper": [
                    255,
                    255,
                    255
                ]
            }
        }
    },
    "特殊编队-决定后判分": {
        "doc": "决定后再次识别界面：只有游戏显示任务开始才进入原生采集；若返回限制弹窗则继续处理，不把点击决定当作条件满足。",
        "next": [
            "特殊编队-限制提示关闭",
            "特殊编队-自动编成确认",
            "特殊编队-队伍决定",
            "特殊编队-开始任务"
        ],
        "timeout": 30000,
        "on_error": []
    },
    "特殊编队-开始任务": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "进本-队伍确认"
                ]
            }
        },
        "next": [
            "进本-点击队伍确认"
        ],
        "on_error": [],
        "doc": "仅供特殊编队链使用，识别开始按钮后汇合原生采集和开始节点；按钮存在不代表游戏已接受编成，点击后的条件拒绝由通用恢复分支处理。"
    }
}
