    "编队身份-采样": {
        "doc": "从 next 获取框架新截图；不把当前节点作为入口直接跳过 recognition。单帧按固定六槽全库粗筛，再用原模板精查；粗筛不可靠时保留原匹配回退，timeout 仍容纳全库慢路径。MCP 只读测试应清空上游“编队身份-采集”的 next，否则会继续“进本-实际点击队伍确认”进入战斗。",
        "next": [
            "编队身份-第1帧"
        ],
        "timeout": 90000,
        "on_error": []
    },
    "编队身份-第1帧": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "formation_identity_frame"
            }
        },
        "timeout": 60000,
        "on_error": []
    },
    "执行自动编队": {
        "doc": "战斗流程的自动编队入口。显式使用空 on_error，确保自动编队失败时任务保持失败并停止，不被全局 Global_Null 恢复链改写为成功。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "auto_formation_from_chaldea"
            }
        },
        "attach": {
            "chaldea_import_source": "",
            "use_support_substitution": false
        },
        "next": [
            "执行羁绊补齐自动编队"
        ],
        "on_error": []
    },
    "执行手动编队检查": {
        "doc": "战斗流程的手动编队核对入口。显式使用空 on_error，确保身份不匹配时任务保持失败并停止，不被全局 Global_Null 恢复链改写为成功。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "validate_formation_from_chaldea"
            }
        },
        "attach": {
            "chaldea_import_source": ""
        },
        "next": [
            "手动编队检查完成"
        ],
        "on_error": []
    },
