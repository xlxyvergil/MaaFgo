    },
    "自动编队-检测编辑决定": {
        "doc": "仅检测，不点击决定。模板与国日服决定文字必须同时命中右下角，不能将开始任务当成进入编辑页；成功后结束子流程，交回脚本继续从者/礼装复核。2026-10-25日服MaaMCP实机模板1.000、OCR決定0.985；可参考自动编队-打开配置的检测优先与有限自循环，检测成功后不能再次点击配置变更。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "battle/编队决定.png",
                                "roi": [1050, 610, 230, 110],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "sub_name": "base/自动编队/自动编队-检测编辑决定/OCR1",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [1050, 610, 230, 110],
                                "expected": ["决定|決定"],
                                "threshold": 0.8
                            }
                        }
                    }
                ]
            }
        },
        "action": {"type": "DoNothing"},
        "next": [],
        "on_error": []
    },
