{
    "编队身份-会话": {
        "doc": "仅由原生入口在任务 Context 中写入会话令牌，不保存队伍结果。",
        "attach": {
            "session_id": ""
        }
    },
    "编队身份-采集": {
        "doc": "只读最终编队快照。个别身份未知可继续，页面/截图失败使旧结果失效并停止；不继承 Global_Null 错误恢复。标定记录不足时不接受确定身份。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "capture_initial_formation"
            }
        },
        "attach": {
            "calibration": {
                "calibration_id": "cal-20260915-teamimg",
                "verified": true,
                "template_family": "NarrowFigures",
                "identity_threshold": 0.8,
                "identity_margin": 0.15
            }
        },
        "on_error": [],
        "next": [
            "进本-实际点击队伍确认"
        ]
    },
    "编队身份-采样": {
        "doc": "从 next 获取框架新截图；不把当前节点作为入口直接跳过 recognition。单帧采集（全库匹配约 28s），timeout 放宽到 90s。",
        "next": [
            "编队身份-第1帧"
        ],
        "timeout": 90000,
        "on_error": []
    },
    "编队身份-第1帧": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "formation_identity_frame"
            }
        },
        "timeout": 60000,
        "on_error": []
    },
    "执行自动编队": {
        "doc": "战斗流程的自动编队入口。显式使用空 on_error，确保自动编队失败时任务保持失败并停止，不被全局 Global_Null 恢复链改写为成功。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "auto_formation_from_chaldea"
            }
        },
        "attach": {
            "chaldea_import_source": "",
            "use_support_substitution": false
        },
        "next": [
            "执行羁绊补齐自动编队"
        ],
        "on_error": []
    },
    "执行手动编队检查": {
        "doc": "战斗流程的手动编队核对入口。显式使用空 on_error，确保身份不匹配时任务保持失败并停止，不被全局 Global_Null 恢复链改写为成功。",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "validate_formation_from_chaldea"
            }
        },
        "attach": {
            "chaldea_import_source": ""
        },
        "next": [
            "手动编队检查完成"
        ],
        "on_error": []
    },
