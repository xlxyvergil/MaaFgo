                                    280,
                                    90
                                ],
                                "expected": [
                                    "幕间物语"
                                ],
                                "threshold": 0.8,
                                "color_filter": "剧情奖励-前景白字过滤"
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    0,
                                    0,
                                    175,
                                    90
                                ],
                                "expected": [
                                    "^关闭$"
                                ],
                                "threshold": 0.8
                            }
                        }
                    }
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 1000,
            "timeout": 5000
        },
        "on_error": []
    }
