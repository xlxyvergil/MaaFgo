  "主线-编制限制": {
    "doc": "仅检测限制标题，不点击。自动推主线开启自动处理时先标记本关受限，再由主线限制编队.json的主线限制-关闭提示处理关闭；随后并列轮询来源选择、自动编成及卡位限制。受限关以游戏编队为准并使用默认战斗，不能关闭后继续套用Chaldea。开关关闭时仍保留现场并停止。",
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [520, 65, 240, 70],
        "expected": ["编成限制", "编制限制", "編成制限"],
        "threshold": 0.8
      }
    }
  },
  "主线-编队弹窗关闭保底": {
    "doc": "主线进编队阶段的未知提示保底：仅在弹窗底部关闭按钮区域OCR命中完整‘关闭’或‘閉じる’时点击文字框，不依赖弹窗标题。优先检查编成限制并提示手动调整，再处理已知提示，最后尝试本节点；每次关闭后重新截图轮询，直到确认编队或战斗界面，保留阶段超时。结算阶段不使用本保底。",
    "recognition": {
      "type": "OCR",
      "param": {
        "roi": [490, 520, 300, 120],
        "expected": ["^关闭$", "^閉じる$"],
        "threshold": 0.8
      }
    },
    "action": {
      "type": "Click"
    },
    "post_delay": 500
  },
  "主线-纯剧情任务开始": {
    "doc": "无战斗关卡的剧情开始确认框，复用 进本流程.json 的 进本-点击任务开始 的识别后点击方式。2026-10-14 日服现场旧 dungeon_enter.png 仅约 0.368，使用 base/image/main_story/story_start.png 的日服按钮裁图，MaaMCP 实测 1.000 并进入剧情；国服仍由 cn 同路径图片覆盖。限定右下确认按钮区域，命中后只点击本按钮，随后由 enter 复核剧情跳过与返回；不能仅凭关闭弹窗计为通关。",
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "template": "main_story/story_start.png",
        "roi": [700, 520, 300, 90],
        "threshold": 0.85
      }
    },
    "action": {
      "type": "Click"
    },
    "post_delay": 1000
  },
