{
  "助战选择-界面标题锚点": {
    "doc": "仅识别右上角助战选择标题。优先使用国日服标题模板，背景变化导致模板未命中时，用同一区域的完整标题 OCR 兜底。列表为空时仍可确认助战界面，卡片上的 NPC 助战标记不能单独确认页面。",
    "recognition": {
      "type": "Or",
      "param": {
        "any_of": [
          {
            "recognition": {
              "type": "TemplateMatch",
              "param": {
                "roi": [900, 0, 380, 90],
                "template": "助战选择界面标记.png",
                "threshold": 0.8
              }
            }
          },
          {
            "sub_name": "base/助战选择/助战选择-界面标题锚点/OCR1",
            "recognition": {
              "type": "OCR",
              "param": {
                "roi": [900, 0, 380, 90],
                "expected": ["^助\\s*战\\s*选\\s*择$", "^サ\\s*ポ\\s*ー\\s*[ト卜]\\s*選\\s*択$"],
                "threshold": 0.8
              }
            }
          }
        ]
      }
    }
  },
  "助战选择-确认按钮锚点": {
    "recognition": {
      "type": "TemplateMatch",
      "param": {
        "roi": [1020, 165, 195, 545],
        "template": "support/助战编入确认.png",
        "threshold": 0.8,
        "order_by": "Vertical"
      }
    }
  }
}
