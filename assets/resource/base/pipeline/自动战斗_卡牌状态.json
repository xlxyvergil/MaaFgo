{
    "战斗_选卡返回主界面": {
        "doc": "开局等牌只读预览满足条件后复用此节点：仅选卡场景命中才点击右下返回；1280×720位置来自2026-10-31日服选卡实图。必须等待主界面确认成功后才能执行原逻辑回合的技能。",
        "recognition": {"type": "And", "param": {"all_of": ["战斗_选卡场景"]}},
        "action": {"type": "Click", "param": {"target": [1194, 682, 1, 1]}},
        "post_delay": 300,
        "next": ["战斗_选卡返回后主界面确认"],
        "on_error": []
    },
    "战斗_选卡返回后主界面确认": {
        "recognition": {"type": "And", "param": {"all_of": ["战斗_主界面"]}},
        "timeout": 5000,
        "next": [],
        "on_error": []
    },
    "战斗_宝具闪光重拍等待": {
        "doc": "NP合成分数位于0.60～0.80且有效遮罩至少10%被中性白高光覆盖时，仅由runtime有界重拍使用。参照战斗_选卡展开等待，无点击；最多观察3帧，每次重拍覆盖整帧结果，不合并旧宝具可用状态。2026-10-31日服白金闪光可把真实NP压低至0.709/0.786，下一相位仍按原0.80阈值确认。",
        "action": {"type": "DoNothing"},
        "post_delay": 300,
        "next": []
    },
    "战斗_选卡展开等待": {
        "doc": "普通面卡先出现，宝具卡稍后展开；等待后再采集完整两排卡面。",
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 1800,
        "next": []
    },
