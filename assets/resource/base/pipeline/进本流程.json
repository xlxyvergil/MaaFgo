{
    "进本流程": {
        "doc": "进本阶段调度中枢(排除法阶段机)。阶段: 进本→剧情(跳过)→助战→剧情→编队→剧情→实际战斗。next 顺序: 关弹窗→助战→编队→实际战斗→盲点兜底。已知界面靠正向识别命中(不盲点零误触); 全部 miss = 未知画面(剧情/加载), 盲点一次右上角跳过按钮位置, 弹'是'则点掉回跳继续, 无弹窗(加载/空点无害)也回跳继续轮询——即'一直点直到知道自己在哪个阶段'。连续出击第2场起仅经历 助战→实际战斗 两阶段。全部 miss 由盲点兜底驱动轮询, timeout 后 on_error 重试",
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-选择助战",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]跳过剧情-直接点击跳过"
        ],
        "on_error": [
            "进本流程-超时重试"
        ],
        "timeout": 30000
    },
    "进本流程-超时重试": {
        "doc": "30s内未见助战/队伍确认界面, 可能是加载慢或中途卡死, 回到轮询重试一轮。max_hit=2: 最多重试2次(共3轮约90s), 之后本节点在 on_error 列表中被跳过, 进本流程 失败向上传播(执行进本→调度节点→任务failed), 由 auto_battle_repeat 弹红字提示",
        "max_hit": 2,
        "focus": {
            "Node.Recognition.Starting": "<span style=\"color: #FF0000;\">进本超时重试（助战/队伍确认界面未出现）</span>"
        },
        "next": [
            "进本流程"
        ]
    },
    "进本-选择助战": {
        "doc": "助战阶段(首个助战): 识别助战界面并点击第一个条目。next 为助战后判分: 弹窗/剧情中断 + 第1场→编队, 连续出击第2场→直接实际战斗; 自引用重试应对点击后界面未刷新",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1020,
                    165,
                    195,
                    545
                ],
                "template": [
                    "support/助战编入确认.png",
                    "support/助战NPC.png"
                ],
                "green_mask": true,
                "threshold": 0.8,
                "order_by": "Vertical"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    591,
                    236,
                    63,
                    39
                ]
            }
        },
        "post_delay": 1500,
        "timeout": 60000,
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-选择助战",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]跳过剧情-直接点击跳过"
        ]
    },
    "助战action": {
        "doc": "助战阶段(自定义筛选): 正向识别到助战选择界面后执行 support_action。原为 DirectHit(当轮必中, 需依赖 队伍确认 前置挡枪, 且连续出击第2场会在 队伍确认 超时卡死), 现加正向识别: 可安全严格排在编队之前, 助战后进入 助战后判分(第1场→编队, 连续出击第2场→直接实际战斗)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1020,
                    165,
                    195,
                    545
                ],
                "template": [
                    "support/助战编入确认.png",
                    "support/助战NPC.png"
                ],
                "green_mask": true,
                "threshold": 0.8,
                "order_by": "Vertical"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "support_action",
                "custom_action_param": {
                    "support_type": "normal"
                }
            }
        },
        "post_delay": 0,
        "timeout": 60000,
        "attach": {
            "ce": "",
            "ce_1": "",
            "ce_2": "",
            "ce_bond": "any",
            "level": 1,
            "np_level": 1,
            "servant": "",
            "skill_active": "",
            "skill_passive": ""
        },
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]跳过剧情-直接点击跳过"
        ]
    },
    "进本-队伍确认": {
        "doc": "编队阶段: 点击开始任务/战斗开始按钮",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "battle/开始任务.png",
                    "battle/战斗开始.png"
                ],
                "threshold": [
                    0.8,
                    0.8
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "进本-开始后弹窗检查",
            "进本-开始按钮已消失"
        ]
    },
    "进本-开始后弹窗检查": {
        "doc": "点击开始任务后, 告知弹窗可能慢几帧才出现并吞掉点击。出现弹窗则关闭并回队伍确认重点; 开始按钮消失则视为已进本, 结束进本链(JumpBack正常生效)。注意: 不能用on_error做成功出口, on_error属于错误处理路径, 会导致JumpBack失效、整条任务链失败",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "close_botton.png",
                    "close.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "next": [
            "进本-开始后弹窗检查",
            "进本-开始按钮已消失"
        ],
        "timeout": 10000
    },
    "进本-开始按钮已消失": {
        "doc": "开始任务/战斗开始按钮不再出现, 视为已成功进入战斗加载。进入 进本-等待战斗主界面或剧情, 由其确认战斗主界面出现后才结束进本链",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "battle/开始任务.png",
                    "battle/战斗开始.png"
                ],
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "next": [
            "进本-等待战斗主界面或剧情"
        ]
    },
    "进本-等待战斗主界面或剧情": {
        "doc": "开始按钮消失后等待战斗主界面出现。剧情用排除法盲点: 战斗主界面 miss 时盲点右上角, 弹'是'则跳过剧情回本节点继续等, 无弹窗(加载中)空点无害继续轮询",
        "next": [
            "进本-战斗主界面已出现",
            "[JumpBack]跳过剧情-直接点击跳过"
        ],
        "timeout": 60000
    },
    "进本-战斗主界面已出现": {
        "doc": "实际战斗阶段入口: 战斗主界面出现, 进本完成。空next正常结束, 链回溯至最近的 [JumpBack](执行进本) 回调度节点继续后续流程; 同时作为 进本流程 与 助战后判分 的兜底终点(连续出击第2场助战后直达实际战斗)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true
            }
        }
    },
    "进本-关闭告知弹窗": {
        "doc": "助战/队伍确认界面可能弹出各种告知弹窗(配置变更/活动报酬/点击继续等), 逐个关闭。空next结束链, 由调用处的 [JumpBack] 回到所属阶段调度(进本流程/助战后判分)继续, 可在不同阶段复用、连续处理多个弹窗",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "close_botton.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "next": []
    },
