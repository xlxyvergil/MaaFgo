{
    "进本流程": {
        "doc": "进本阶段调度中枢：关弹窗→助战→编队→实际战斗→有限盲点兜底。每场最多盲点60次，用尽后仅轮询已知界面；仍未命中则超时重试，不能无限点击右上角。timeout 只限制一次 next 查找，不是循环总时长。",
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-选择助战",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]进本-盲点跳过剧情"
        ],
        "on_error": [
            "进本流程-超时重试"
        ],
        "timeout": 30000
    },
    "进本流程-超时重试": {
        "doc": "一轮 next 查找超时后最多重试2次；不重置本场盲点预算。耗尽盲点后仍无已知界面则最终失败，向上传播到战斗任务；不可将三轮timeout解释为整个进本固定90秒。",
        "max_hit": 2,
        "focus": {
            "Node.Recognition.Starting": "<span style=\"color: #FF0000;\">进本超时重试（助战/队伍确认界面未出现）</span>"
        },
        "next": [
            "进本流程"
        ]
    },
    "进本-选择助战": {
        "doc": "助战阶段(首个助战): 识别助战界面并点击第一个条目。next 为助战后判分: 弹窗/剧情中断 + 第1场→编队, 连续出击第2场→直接实际战斗; 自引用重试应对点击后界面未刷新",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1020,
                    165,
                    195,
                    545
                ],
                "template": [
                    "support/助战编入确认.png",
                    "support/助战NPC.png"
                ],
                "green_mask": true,
                "threshold": 0.8,
                "order_by": "Vertical"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    591,
                    236,
                    63,
                    39
                ]
            }
        },
        "post_delay": 1500,
        "timeout": 60000,
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-选择助战",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]进本-盲点跳过剧情"
        ]
    },
    "助战action": {
        "doc": "助战阶段(自定义筛选): 正向识别到助战选择界面后执行 support_action。原为 DirectHit(当轮必中, 需依赖 队伍确认 前置挡枪, 且连续出击第2场会在 队伍确认 超时卡死), 现加正向识别: 可安全严格排在编队之前, 助战后进入 助战后判分(第1场→编队, 连续出击第2场→直接实际战斗)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1020,
                    165,
                    195,
                    545
                ],
                "template": [
                    "support/助战编入确认.png",
                    "support/助战NPC.png"
                ],
                "green_mask": true,
                "threshold": 0.8,
                "order_by": "Vertical"
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "support_action",
                "custom_action_param": {
                    "support_type": "normal"
                }
            }
        },
        "post_delay": 0,
        "timeout": 60000,
        "attach": {
            "ce": "",
            "ce_1": "",
            "ce_2": "",
            "ce_bond": "any",
            "level": 1,
            "np_level": 1,
            "servant": "",
            "skill_active": "",
            "skill_passive": ""
        },
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]进本-盲点跳过剧情"
        ]
    },
    "Chaldea助战action": {
        "doc": "助战阶段(Chaldea 配置): 参照助战action的助战页识别与头像/OCR筛选；先读取已启用的 Chaldea 队伍并筛选唯一标记助战。实机验证等级条件依赖 OCR 模型可读取；输入、队伍或匹配失败时立即停止，不进入编队后续或战斗。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1020, 165, 195, 545],
                "template": ["support/助战编入确认.png", "support/助战NPC.png"],
                "green_mask": true,
                "threshold": 0.8,
                "order_by": "Vertical"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "support_action",
                "custom_action_param": {
                    "source_mode": "chaldea"
                }
            }
        },
        "timeout": 60000,
        "attach": {
            "chaldea_enabled": false,
            "chaldea_import_source": ""
        },
        "next": [
            "[JumpBack]进本-关闭告知弹窗",
            "进本-队伍确认",
            "进本-战斗主界面已出现",
            "[JumpBack]进本-盲点跳过剧情"
        ],
        "on_error": []
    },
    "进本-队伍确认": {
        "doc": "编队阶段入口: 正向识别开始任务/战斗开始按钮后进入编队处理调度。默认直接点击开始；启用 Chaldea 队伍时按编队方式检查或自动编队",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "battle/开始任务.png",
                    "battle/战斗开始.png"
                ],
                "threshold": [
                    0.8,
                    0.8
                ]
            }
        },
        "next": [
            "进本-编队处理"
        ]
    },
    "进本-编队处理": {
        "doc": "编队处理调度。默认保持原流程直接点击开始；使用 Chaldea 队伍时由编队方式覆盖为手动检查或自动编队",
        "next": [
            "进本-点击队伍确认"
        ]
    },
    "进本-点击队伍确认": {
        "doc": "编队完成后的汇合点。默认保持直接开始；仅原生会话在 Context 内改为先采集初始编队，Chaldea 各完成分支仍汇合于此。",
        "next": [
            "进本-实际点击队伍确认"
        ]
    },
    "进本-实际点击队伍确认": {
        "doc": "编队处理完成后点击开始任务/战斗开始按钮",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "battle/开始任务.png",
                    "battle/战斗开始.png"
                ],
                "threshold": [
                    0.8,
                    0.8
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "进本-开始后弹窗检查",
            "进本-开始按钮已消失"
        ]
    },
    "进本-开始后弹窗检查": {
        "doc": "点击开始任务后, 告知弹窗可能慢几帧才出现并吞掉点击。出现弹窗则关闭并回队伍确认重点; 开始按钮消失则视为已进本, 结束进本链(JumpBack正常生效)。注意: 不能用on_error做成功出口, on_error属于错误处理路径, 会导致JumpBack失效、整条任务链失败",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "close_botton.png",
                    "close.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "next": [
            "进本-开始后弹窗检查",
            "进本-开始按钮已消失"
        ],
        "timeout": 10000
    },
    "进本-开始按钮已消失": {
        "doc": "开始任务/战斗开始按钮不再出现, 视为已成功进入战斗加载。进入 进本-等待战斗主界面或剧情, 由其确认战斗主界面出现后才结束进本链",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "battle/开始任务.png",
                    "battle/战斗开始.png"
                ],
                "threshold": 0.8
            }
        },
        "inverse": true,
        "timeout": 3000,
        "next": [
            "进本-等待战斗主界面或剧情"
        ]
    },
    "进本-等待战斗主界面或剧情": {
        "doc": "开始按钮消失后等待战斗主界面；未知画面复用本场有限盲点预算处理剧情，预算用尽后仅等待主界面，仍未出现则超时失败。",
        "next": [
            "进本-战斗主界面已出现",
            "[JumpBack]进本-盲点跳过剧情"
        ],
        "timeout": 60000
    },
    "进本-盲点跳过剧情": {
        "doc": "进本轮询专用包装节点，每场最多盲点60次；耗尽后从候选列表跳过，保留正向识别和超时出口。每场/每关重置此计数，关闭跳过剧情时禁用本节点。通用一次性跳过节点不受本预算影响。",
        "max_hit": 60,
        "next": [
            "跳过剧情-直接点击跳过"
        ]
    },
    "进本-战斗主界面已出现": {
        "doc": "实际战斗阶段入口: 战斗主界面出现, 进本完成。空next正常结束, 链回溯至最近的 [JumpBack](执行进本) 回调度节点继续后续流程; 同时作为 进本流程 与 助战后判分 的兜底终点(连续出击第2场助战后直达实际战斗)",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true
            }
        }
    },
    "进本-关闭告知弹窗": {
        "doc": "助战/队伍确认界面可能弹出各种告知弹窗(配置变更/活动报酬/点击继续等), 逐个关闭。空next结束链, 由调用处的 [JumpBack] 回到所属阶段调度(进本流程/助战后判分)继续, 可在不同阶段复用、连续处理多个弹窗",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "close_botton.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500,
        "next": []
    },
