    "战斗_战利品弹窗": {
        "doc": "正常结算顺序为羁绊→经验→战利品。仅标题和下一步同时命中才确认已到战利品页；羁绊检查尚未完成时提示并跳过本场检查。",
        "recognition": {"type": "And", "param": {
            "all_of": ["战斗_战利品标题", "战斗_战利品下一步"], "box_index": 1
        }}
    },
    "战斗_战利品标题": {
        "recognition": {"type": "OCR", "param": {
            "roi": [90, 20, 390, 65],
            "expected": ["获得.*战利品", "獲得した戦利品"], "threshold": 0.8
        }}
    },
    "战斗_战利品下一步": {
        "recognition": {"type": "TemplateMatch", "param": {
            "template": "battle/下一步.png", "roi": [900, 570, 380, 150], "threshold": 0.8
        }}
    },
    "战斗_经验结算页": {
        "doc": "只在经验标题区域识别“获得经验值”或“獲得EXP”。“战斗结果”和触屏提示也会出现在羁绊结算，经验页无需依赖它们。",
        "recognition": {"type": "OCR", "param": {
            "roi": [640, 165, 300, 80],
            "expected": ["獲得EXP", "获得EXP", "获得经验值"], "threshold": 0.8
        }}
    },
