    "战斗_失败": {
        "doc": "同时覆盖常规全灭页面与地狱试炼不可续关的战斗结束弹窗。试炼分支必须同时命中失败标题和劝退正文，仅识别，不关闭或重试。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "战斗_失败_常规",
                    "战斗_失败_地狱试炼"
                ]
            }
        }
    },
    "战斗_失败_地狱试炼": {
        "recognition": {
            "type": "And",
            "param": {
