{
    "战斗-出卡后下载重试": {
        "doc": "原生自动战斗通用出卡后轮询专用；参考进本-断网重连，复用右侧重试按钮模板及日服OCR区域，不点左侧退出。仅识别并点击按钮，下一回合/胜利/失败仍由runtime重新截图确认；不重发指令卡、不重置动画等待总时限、不使用画面冻结检测。2026-11-18国服资源下载失败截图中按钮位于右下[700,510,300,110]附近。",
        "recognition": {
            "type": "And",
            "param": {"all_of": ["进本-断网重连"]}
        },
        "action": {"type": "Click"},
        "post_delay": 1000,
        "timeout": 1000,
        "next": [],
        "on_error": []
    },
    "战斗_主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true
            }
        }
    },
    "战斗_换人后等待主界面": {
        "doc": "由runtime在换人或候补入场后调用：固定等待3秒过渡，再由next在8秒内识别主界面；不点击，不更新阵容，不做画面冻结检测。",
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 3000,
        "timeout": 8000,
        "next": [
            "战斗_换人后主界面"
        ],
        "on_error": []
    },
    "战斗_换人后主界面": {
        "doc": "沿用战斗主界面模板、ROI及0.7阈值；命中即返回runtime，停止或超时不更新阵容。战斗画面有持续动画，不以像素静止作为继续条件。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true,
                "threshold": 0.7
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [],
        "on_error": []
    },
