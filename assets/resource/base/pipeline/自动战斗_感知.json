{
    "战斗_主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true
            }
        }
    },
    "战斗_换人后等待主界面": {
        "doc": "由runtime在换人或候补入场后调用：固定等待3秒过渡，再由next在8秒内识别主界面；不点击，不更新阵容，不做画面冻结检测。",
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 3000,
        "timeout": 8000,
        "next": [
            "战斗_换人后主界面"
        ],
        "on_error": []
    },
    "战斗_换人后主界面": {
        "doc": "沿用战斗主界面模板、ROI及0.7阈值；命中即返回runtime，停止或超时不更新阵容。战斗画面有持续动画，不以像素静止作为继续条件。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1058,
                    508,
                    152,
                    54
                ],
                "template": "battle/scene_main_battle.png",
                "green_mask": true,
                "threshold": 0.7
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "next": [],
        "on_error": []
    },
