  "_guideNotes": {
    "source": "用户提供的「骑阶冠位钻研战 配队02」截图",
    "sourceImage": "codex-clipboard-01807bdc-c206-4007-9e38-a22c861952d6.png",
    "sourceSha256": "5664e3e489a178f51d17825e54f4ab7e6a94e0205b77414713c80d29fe11ef76",
    "status": "根据攻略截图转写；已做离线格式、助战资源及原生战斗转换检查，未实机验证伤害或通关。",
    "executor": "原生自动战斗；导入方式选择 Chaldea 队伍，助战选择使用编辑器/Chaldea 配置。",
    "formation": "保留原图前排次序；后三槽不要求，使用前请确保无额外候补影响 Cost 或战斗。",
    "support": "原图未标注助战，生成时将主输出设为第二槽助战；可在编辑器改选其他槽位，必须保证恰好一个助战。",
    "requirements": [
      "莱妮丝和骑阶龙马均为冠位；魔力装填至少解锁 Lv1（10% NP），羁绊礼装均选择 NP50。",
      "骑阶普通天赋树点满；龙马冠位树需要 Arts 魔放与御主技能强化；龙马使用强化后宝具，莱妮丝3技能已强化。"
    ],
    "adaptations": [
      "原图“龙马全技能12”有重复数字，按全技能1/2/3各一次处理，不重复施放冷却中的技能。"
    ],
    "manualSetup": [
      "从者、宝具、主动技能强化及附加技能必须在游戏中已达到所列条件，JSON 不会自动升级。",
      "冠位从者的礼装当前不会由自动编队调整；须在游戏中手动装备普通/羁绊/追加三槽，并核对羁绊 NP50 或初始效果。",
      "骑阶普通树、冠位树的具体节点和御主技能强化需手动核对；classBoardData 中只记录可读取的羁绊效果，未虚构树节点字段。",
      "御主礼装按 Lv10 记录；图中未给出等级，低等级或缺少冠位御主强化时伤害可能不足。"
    ],
    "turn1": "莱妮丝1、3给自己、2给龙马；龙马1、2、3；尼莫1、3；极地服2给龙马；莱妮丝宝具→龙马宝具→默认普通卡。",
    "afterScript": "仅配置 T1；未击杀时，固定回合结束后交回原生通用战斗逻辑，不能视为攻略保证一回合击杀。",
